# App Configuration
APP_NAME="ThatRank HR"
APP_ENV=production
APP_URL=https://team.thatrank.com
TIMEZONE=Asia/Kolkata
APP_SECRET=

# Database Configuration (MySQL 8 / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thatrank_hr_software
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Mail / SMTP (Hostinger Mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@thatrank.com
SMTP_NAME="ThatRank HR"
ADMIN_EMAIL=admin@thatrank.com

# Alerts / Webhook (n8n on ThatRank VPS)
N8N_WEBHOOK_URL=

# Storage Paths
STORAGE_PATH=../storage

