# Apache configuration for ThatRank HR Project Root
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    <IfModule mod_autoindex.c>
        Options -Indexes
    </IfModule>

    # Block access to .env, .git, sensitive directories, composer files, SQL, and Markdown files (return 403)
    RewriteRule (^|/)\.env - [F,L,NC]
    RewriteRule (^|/)\.git - [F,L,NC]
    RewriteRule (^|/)(app|config|cron|database|storage|vendor|tests)(/.*)?$ - [F,L,NC]
    RewriteRule \.(sql|md)$ - [F,L,NC]
    RewriteRule (^|/)composer\..*$ - [F,L,NC]

    # Stop rewrite processing if the request is already in public/
    RewriteRule ^public(/.*)?$ - [L]

    # Rewrite root request to public/
    RewriteRule ^$ public/ [L]

    # Rewrite all other requests to public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# DirectoryIndex fallback
DirectoryIndex index.php public/index.php
