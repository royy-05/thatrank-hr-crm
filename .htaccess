# Apache configuration for ThatRank HR Project Root
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing safely
    <IfModule mod_autoindex.c>
        Options -Indexes
    </IfModule>

    # Block access to hidden files and dotfiles (.env, .git, etc.)
    RewriteRule ^\..* - [F,L]

    # Block direct access to sensitive backend directories
    RewriteRule ^(app|config|cron|database|storage|tests|vendor)(/.*)?$ - [F,L]

    # Block direct access to non-public configuration and docs
    RewriteRule ^(composer\.(json|lock)|composer\.phar|SCOPE\.(md|docx)|desktop\.ini) - [F,L]

    # Route asset requests to public/assets/ if requested from root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]

    # Route sw.js and manifest.json to public/ if requested from root
    RewriteRule ^(sw\.js|manifest\.json)$ public/$1 [L,NC]

    # Route all clean URLs and API requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# DirectoryIndex fallback
DirectoryIndex index.php public/index.php

